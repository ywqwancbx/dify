FROM node:22.11.0-alpine AS web-builder

# 接收代理参数
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

# 设置代理环境变量
ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}
ENV NO_PROXY=${NO_PROXY}

WORKDIR /app/web

# 复制package.json和pnpm-lock.yaml
COPY ./web/package.json ./web/pnpm-lock.yaml ./

# 安装pnpm
RUN npm install -g pnpm@10.19.0

# 配置代理和国内镜像源
RUN npm config set proxy http://192.168.2.170:18111 \
    && npm config set https-proxy http://192.168.2.170:18111 \
    && npm config set registry https://registry.npmmirror.com \
    && pnpm config set proxy http://192.168.2.170:18111 \
    && pnpm config set https-proxy http://192.168.2.170:18111 \
    && pnpm config set registry https://registry.npmmirror.com

# 安装依赖
RUN pnpm install --frozen-lockfile

# 复制源代码
COPY ./web .

# 构建应用 - 增加内存限制
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm build

# 生产环境镜像
FROM node:22.11.0-alpine

# 接收代理参数
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

# 设置代理环境变量
ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}
ENV NO_PROXY=${NO_PROXY}

WORKDIR /app/web

# 安装pnpm
RUN npm install -g pnpm@10.19.0

# 配置代理和国内镜像源
RUN npm config set proxy http://192.168.2.170:18111 \
    && npm config set https-proxy http://192.168.2.170:18111 \
    && npm config set registry https://registry.npmmirror.com \
    && pnpm config set proxy http://192.168.2.170:18111 \
    && pnpm config set https-proxy http://192.168.2.170:18111 \
    && pnpm config set registry https://registry.npmmirror.com

# 复制package.json和pnpm-lock.yaml
COPY ./web/package.json ./web/pnpm-lock.yaml ./

# 安装生产依赖 - 跳过husky
RUN pnpm install --frozen-lockfile --prod --ignore-scripts

# 从构建阶段复制编译后的文件
COPY --from=web-builder /app/web/.next ./.next
COPY --from=web-builder /app/web/public ./public
COPY --from=web-builder /app/web/next.config.js ./
COPY --from=web-builder /app/web/scripts ./scripts

# 设置权限
RUN chmod +x ./scripts/copy-and-start.mjs

# 暴露端口
EXPOSE 3000

CMD ["pnpm", "start"]
