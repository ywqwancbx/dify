# Dify环境变量配置
# 数据库配置
DB_USERNAME=postgres
DB_PASSWORD=difyai123456
DB_DATABASE=dify

# Redis配置
REDIS_PASSWORD=difyai123456

# API配置 - 外部访问URL
CONSOLE_API_URL=
APP_API_URL=
CONSOLE_WEB_URL=http://10.8.8.2:8080
APP_WEB_URL=http://10.8.8.2:8080

# 前端API前缀配置
NEXT_PUBLIC_API_PREFIX=/console/api
NEXT_PUBLIC_PUBLIC_API_PREFIX=/api

# 修改端口避免冲突
EXPOSE_NGINX_PORT=8080
EXPOSE_NGINX_SSL_PORT=8443

# 管理员API密钥配置
ADMIN_API_KEY_ENABLE=true
ADMIN_API_KEY=your-admin-api-key-here

# EAM集成配置
EAM_VERIFY_URL=http://10.8.8.2:8000/api/v1/external/dify/verify

# 文件服务配置
FILES_URL=http://10.8.8.2:8080/files
INTERNAL_FILES_URL=http://api:5001/files

# Webapp认证配置
WEBAPP_AUTH_ENABLE=true

# 企业版功能配置
ENTERPRISE_ENABLED=false

# 初始化配置
INIT_PASSWORD=admin123456
# 上面密码仅在首次初始化时使用，已初始化环境可忽略