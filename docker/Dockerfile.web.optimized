# 基础依赖镜像 - 可以预先构建并推送到registry
FROM node:22.11.0-alpine AS web-deps

WORKDIR /app/web

# 安装pnpm
RUN npm install -g pnpm@10.19.0

# 复制package.json和pnpm-lock.yaml
COPY ./web/package.json ./web/pnpm-lock.yaml ./

# 安装所有依赖（包括devDependencies）
RUN pnpm install --frozen-lockfile

# 构建阶段 - 基于依赖镜像
FROM web-deps AS web-builder

# 复制源代码
COPY ./web .

# 构建应用 - 增加内存限制
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm build

# 生产环境镜像
FROM node:22.11.0-alpine AS web-prod

WORKDIR /app/web

# 安装pnpm
RUN npm install -g pnpm@10.19.0

# 复制package.json和pnpm-lock.yaml
COPY ./web/package.json ./web/pnpm-lock.yaml ./

# 安装生产依赖 - 跳过husky
RUN pnpm install --frozen-lockfile --prod --ignore-scripts

# 从构建阶段复制编译后的文件
COPY --from=web-builder /app/web/.next ./.next
COPY --from=web-builder /app/web/public ./public
COPY --from=web-builder /app/web/next.config.js ./
COPY --from=web-builder /app/web/scripts ./scripts

# 设置权限
RUN chmod +x ./scripts/copy-and-start.mjs

# 暴露端口
EXPOSE 3000

CMD ["pnpm", "start"]
